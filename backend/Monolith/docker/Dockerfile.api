FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS base
WORKDIR /app
EXPOSE 8081

FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

COPY src/Directory.Build.props .
COPY src/Directory.Packages.props .

COPY src/Core.Domain/Core.Domain.csproj Core.Domain/
COPY src/Migrations/Migrations.csproj Migrations/
COPY src/Bootstrap.Api/Bootstrap.Api.csproj Bootstrap.Api/
COPY src/Adapters.Outbound.Postgres/Adapters.Outbound.Postgres.csproj Adapters.Outbound.Postgres/
COPY src/Adapters.Inbound.Http/Adapters.Inbound.Http.csproj Adapters.Inbound.Http/
COPY src/Core.Application/Core.Application.csproj Core.Application/

RUN dotnet restore Bootstrap.Api/Bootstrap.Api.csproj

COPY src/ .

RUN dotnet publish Bootstrap.Api/Bootstrap.Api.csproj \
    -c Release \
    -o /app/publish \
    --no-restore \
    /p:UseAppHost=false

FROM base AS final
WORKDIR /app
COPY --from=build /app/publish .
ENTRYPOINT ["dotnet", "Bootstrap.Api.dll"]
